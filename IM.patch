+    @Test
+    fun v1SlowInfoStartupQueryMatchesCarTypeResponse() {
+        // The V1 slow-info startup query must exist and its MAIN_INFO  (car type)
+        // response must match, so the query completes and the model latches.
+        val plan = protocol.getPollingPlan()
+         val slowInfo = plan.startupQueries.first { it.id == "inmotion.v1-slow-info" }
+        val request = slowInfo.value as ByteArray
+        assertTrue(request.size >= 2 && request[0] == 0xA.toByte() && request[1] == 0xAA.toByte())
+        // Car-type page captured from a real V9: AA AA 11 08 82 01 02 0C 01 01 01 00 95
+        val carType = ByteUtils.hexToBytes("AAAA110882010210C0101010095")
+        assertTrue(protocol.matchesQueryResponse(slowInfo, carType))
+        protocol.decode(carType)
+        assertEquals("InMotion V9", protocol.lastDecodedModel())
+    }
+
     @Test
     fun getPollingPlanDoesNotProbeV14BmsAddressesOnV9() {
