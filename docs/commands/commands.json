  "protocols": {
    "KingsongProtocol": {
      "hardwareLimits": "unknown",
      "commands": {
        "LIGHT_ON": { "name": "Headlight on", "description": "Enable the headlight.", "encoding": "available", "input": { "kind": "none" } },
        "LIGHT_OFF": { "name": "Headlight off", "description": "Disable the headlight.", "encoding": "available", "input": { "kind": "none" } },
        "SET_LIGHT_MODE": {
          "name": "Headlight mode", "description": "Select off, on or automatic lighting.", "encoding": "available",
          "input": { "kind": "choice", "valueType": "integer", "options": [
            { "id": "off", "value": 0 }, { "id": "on", "value": 1 }, { "id": "auto", "value": 2 }
          ] }
        },
        "LIGHT_BRIGHTNESS": {
          "name": "Headlight state", "description": "Three lighting states, not continuous dimming.", "encoding": "available",
          "input": { "kind": "choice", "valueType": "integer", "options": [
            { "id": "off", "value": 0 }, { "id": "on", "value": 1 }, { "id": "auto", "value": 100 }
          ] }
        },
        "BEEP": { "name": "Horn", "description": "Sound the wheel horn.", "encoding": "available", "input": { "kind": "none" } },
        "POWER_OFF": { "name": "Power off", "description": "Turn off the wheel.", "encoding": "available", "input": { "kind": "none" } },
        "AUTHENTICATE": {
          "name": "Authenticate", "description": "Submit a four-ASCII-digit PIN; preserve leading zeros.", "encoding": "available",
          "input": { "kind": "text", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$", "sensitive": true }
        },
        "SET_PASSWORD": {
          "name": "Set password", "description": "Set a four-ASCII-digit password.", "encoding": "available",
          "input": { "kind": "text", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$", "sensitive": true }
        },
        "CHANGE_PASSWORD": {
          "name": "Change password", "description": "Replace the password using the current password.", "encoding": "available",
          "input": { "kind": "record", "apiType": "PasswordChangeRequest", "fields": [
            { "id": "oldPassword", "input": { "kind": "text", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$", "sensitive": true } },
            { "id": "newPassword", "input": { "kind": "text", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$", "sensitive": true } }
          ] }
        },
        "REMOVE_PASSWORD": {
          "name": "Remove password", "description": "Remove protection using the current password.", "encoding": "available",
          "input": { "kind": "text", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$", "sensitive": true }
        },
        "LOCK": { "name": "Lock", "description": "Lock the wheel after required authentication.", "encoding": "conditional", "input": { "kind": "none" } },
        "UNLOCK": { "name": "Unlock", "description": "Unlock using the wheel-provided challenge after authentication.", "encoding": "conditional", "input": { "kind": "none" } },
        "REQUEST_LOCK_STATE": { "name": "Lock state", "description": "Request wheel-confirmed lock status.", "encoding": "available", "operation": "query", "input": { "kind": "none" } },
        "SET_PEDALS_MODE": {
          "name": "Pedal mode", "description": "Select a pedal mode code; semantic labels are unverified.", "encoding": "available",
          "input": { "kind": "choice", "valueType": "integer", "options": [
            { "id": "mode_0", "value": 0 }, { "id": "mode_1", "value": 1 }, { "id": "mode_2", "value": 2 }
          ] }
        },
        "SET_LED_MODE": {
          "name": "LED mode", "description": "LED mode code; valid model-specific modes are unverified.", "encoding": "available",
          "input": { "kind": "range", "valueType": "integer", "min": 0, "max": 255, "step": 1, "unit": "mode_code" }
        },
        "SET_SPEED_LIMIT": {
          "name": "Speed limit", "description": "Change maximum speed while preserving previously received alarm settings.", "encoding": "conditional",
          "input": { "kind": "range", "valueType": "integer", "min": 0, "max": 100, "step": 1, "unit": "km/h" }
        },
        "SET_ALARM_SPEED": {
          "name": "Alarm speeds", "description": "Set all three alarms while preserving the previously received maximum speed.", "encoding": "conditional",
          "input": { "kind": "tuple", "apiType": "CommandValue.Integers", "fields": [
            { "id": "alarm1", "input": { "kind": "range", "valueType": "integer", "min": 0, "max": 100, "step": 1, "unit": "km/h" } },
            { "id": "alarm2", "input": { "kind": "range", "valueType": "integer", "min": 0, "max": 100, "step": 1, "unit": "km/h" } },
            { "id": "alarm3", "input": { "kind": "range", "valueType": "integer", "min": 0, "max": 100, "step": 1, "unit": "km/h" } }
          ] }
        },
        "CALIBRATE": { "name": "Calibrate", "description": "Start wheel calibration.", "encoding": "available", "input": { "kind": "none" } },
        "REQUEST_SERIAL": { "name": "Serial number", "description": "Request the wheel serial number.", "encoding": "available", "operation": "query", "input": { "kind": "none" } },
        "REQUEST_FIRMWARE": { "name": "Firmware version", "description": "Request firmware identification.", "encoding": "available", "operation": "query", "input": { "kind": "none" } },
        "REQUEST_BMS_SERIAL": { "name": "BMS serial number", "description": "Request BMS identification.", "encoding": "available", "operation": "query", "input": { "kind": "none" } },
        "SET_LED_STROBE": {
          "name": "LED strobe", "description": "Strobe mode code; valid model-specific modes are unverified.", "encoding": "available",
          "input": { "kind": "range", "valueType": "integer", "min": 0, "max": 255, "step": 1, "unit": "mode_code" }
        },
        "SET_CHARGE_LIMIT": {
          "name": "Charge limit", "description": "Set charge cutoff percentage.", "encoding": "available",
          "input": { "kind": "range", "valueType": "integer", "min": 0, "max": 100, "step": 1, "unit": "percent" }
        },
        "SET_STANDBY_DELAY": {
          "name": "Standby delay", "description": "Set idle power-off delay; bounds describe encoding capacity.", "encoding": "available",
          "input": { "kind": "range", "valueType": "integer", "min": 0, "max": 65535, "step": 1, "unit": "second" }
        },
        "SET_PEDAL_CUTOFF_ANGLE": {
          "name": "Pedal cutoff angle", "description": "Set cutoff angle in tenths of a degree; bounds describe encoding capacity.", "encoding": "available",
          "input": { "kind": "range", "valueType": "integer", "min": 0, "max": 65535, "step": 1, "unit": "degree", "scale": 0.1 }
        },
        "SET_PEDAL_PITCH_TRIM": {
          "name": "Pedal pitch trim", "description": "Set signed pitch trim in tenths of a degree; bounds describe encoding capacity.", "encoding": "available",
          "input": { "kind": "range", "valueType": "integer", "min": -32768, "max": 32767, "step": 1, "unit": "degree", "scale": 0.1 }
        },
        "CUSTOM": {
          "name": "Raw command", "description": "Unvalidated payload for a dedicated handler.", "encoding": "available", "operation": "raw",
          "input": { "kind": "raw_payload", "description": "Owned bytes.", "valueTypes": ["bytes"] }
        }
