{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EUC command dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocols"],
  "properties": {
    "$schema": { "const": "./commands.schema.json" },
    "schemaVersion": { "const": 1 },
    "protocols": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hardwareLimits", "commands", "profiles"],
        "properties": {
          "hardwareLimits": { "const": "unknown" },
          "commands": { "$ref": "#/$defs/commands" },
          "profiles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "match", "commands"],
              "properties": {
                "id": { "$ref": "#/$defs/string" },
                "match": {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "properties": {
                    "models": { "$ref": "#/$defs/strings" },
                    "dialects": { "$ref": "#/$defs/strings" }
                  }
                },
                "commands": { "$ref": "#/$defs/commands" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "string": { "type": "string", "minLength": 1 },
    "strings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/string" } },
    "commandId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$" },
    "commands": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/commandId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "encoding", "input"],
        "properties": {
          "name": { "$ref": "#/$defs/string" },
          "description": { "$ref": "#/$defs/string" },
          "encoding": { "enum": ["available", "conditional", "unavailable", "unknown"] },
          "operation": { "$ref": "#/$defs/string" },
          "input": { "$ref": "#/$defs/input" }
        }
      }
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "enum": ["none", "boolean"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "valueType", "min", "max", "step", "unit"],
          "properties": {
            "kind": { "const": "range" },
            "valueType": { "const": "integer" },
            "min": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
            "max": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
            "step": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
            "unit": { "$ref": "#/$defs/string" },
            "scale": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "valueType", "options"],
          "properties": {
            "kind": { "const": "choice" },
            "valueType": { "const": "integer" },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "value"],
                "properties": {
                  "id": { "$ref": "#/$defs/string" },
                  "value": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "minLength", "maxLength", "pattern", "sensitive"],
          "properties": {
            "kind": { "const": "text" },
            "minLength": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
            "maxLength": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
            "pattern": { "$ref": "#/$defs/string" },
            "sensitive": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "apiType", "fields"],
          "properties": {
            "kind": { "enum": ["tuple", "record"] },
            "apiType": { "$ref": "#/$defs/string" },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "input"],
                "properties": {
                  "id": { "$ref": "#/$defs/string" },
                  "input": { "$ref": "#/$defs/input" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "unknown" },
            "reason": { "$ref": "#/$defs/string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description", "valueTypes"],
          "properties": {
            "kind": { "const": "raw_payload" },
            "description": { "$ref": "#/$defs/string" },
            "valueTypes": { "$ref": "#/$defs/strings" }
          }
        }
      ]
    }
  }
}
